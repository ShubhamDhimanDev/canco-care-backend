APP_NAME="Canco Cares Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Canco Cares -------------------------------------------------------------
# Keys below are placeholders for features that are still being built.

# Public website (Next.js) that consumes the API.
FRONT_URL=http://localhost:3000

# Secrets shared with the Next.js app (put the same values in front/.env.local).
# Generate long random values, e.g. php artisan tinker --execute="echo Str::random(48);"
FRONTEND_API_KEY=
REVALIDATE_SECRET=

# Bot protection for the public forms, verified server-side.
TURNSTILE_SECRET_KEY=

# Global Payments - put the SANDBOX credentials here. Never commit real values.
GP_ENVIRONMENT=test
GP_APP_ID=
GP_APP_KEY=
GP_CURRENCY=CAD
GP_WEBHOOK_SECRET=

# Inquiry recipients are managed in the admin (Settings > Inquiries), not in this file.
# Mail stays on the "log" driver above until real SMTP details are added (MAIL_*).
